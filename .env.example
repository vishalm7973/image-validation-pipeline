# Used by backend when running locally. Docker Compose overrides hostnames appropriately.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aragon_images?schema=public
REDIS_URL=redis://localhost:6379
PORT=4000
UPLOAD_DIR=./uploads
MAX_FILE_MB=15
MIN_WIDTH=400
MIN_HEIGHT=400
MIN_FACE_RATIO=0.12
BLUR_THRESHOLD=35
PHASH_DISTANCE_THRESHOLD=8
# Optional S3-compatible storage (leave blank for local durable uploads folder)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
